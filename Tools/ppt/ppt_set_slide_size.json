{
  "id": "ppt_set_slide_size",
  "name": "ppt_set_slide_size",
  "description": "【高危】修改演示文稿页面尺寸（16:9 / 4:3 / A4 / 自定义）。会改变所有页面布局，必须显式传 confirm=true。",
  "appType": "ppt",
  "category": "幻灯片操作",
  "riskLevel": "high",
  "parameters": [
    { "name": "size", "type": "string", "required": false, "description": "16:9、4:3、a4 或 custom，默认 16:9。" },
    { "name": "width", "type": "number", "required": false, "description": "size=custom 时的宽度（磅）。" },
    { "name": "height", "type": "number", "required": false, "description": "size=custom 时的高度（磅）。" },
    { "name": "confirm", "type": "boolean", "required": false, "description": "必须为 true 才会修改。" }
  ]
}
