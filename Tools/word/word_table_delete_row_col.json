{
  "id": "word_table_delete_row_col",
  "name": "word_table_delete_row_col",
  "description": "删除表格指定行/列区间（倒序删除）。该高危操作复用 SecurityGate 的 security.allowDeleteSheet 配置，默认拒绝；合并单元格导致失败时返回原因。示例：word_table_delete_row_col {\"tableIndex\":1,\"target\":\"row\",\"index\":2,\"count\":1}",
  "appType": "word",
  "category": "write",
  "riskLevel": "high",
  "parameters": [
    {
      "name": "tableIndex",
      "type": "integer",
      "required": true,
      "description": "表格索引，1 基。"
    },
    {
      "name": "target",
      "type": "string",
      "required": true,
      "description": "row 或 column。"
    },
    {
      "name": "index",
      "type": "integer",
      "required": true,
      "description": "起始行/列，1 基。"
    },
    {
      "name": "count",
      "type": "integer",
      "required": false,
      "description": "删除数量，1-200，默认 1。"
    }
  ]
}
