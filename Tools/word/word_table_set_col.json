{
  "id": "word_table_set_col",
  "name": "word_table_set_col",
  "description": "按行顺序写入整列 values 数组，可设置列字体子集；逐格回读，倒序写入。示例：word_table_set_col {\"tableIndex\":1,\"col\":2,\"values\":[\"90\",\"85\",\"78\"]}",
  "appType": "word",
  "category": "write",
  "riskLevel": "medium",
  "parameters": [
    {
      "name": "tableIndex",
      "type": "integer",
      "required": true,
      "description": "表格索引，1 基。"
    },
    {
      "name": "col",
      "type": "integer",
      "required": true,
      "description": "列号，1 基。"
    },
    {
      "name": "values",
      "type": "array",
      "required": true,
      "description": "按行顺序的字符串数组，可为空字符串。"
    },
    {
      "name": "format",
      "type": "object",
      "required": false,
      "description": "字体子集：bold/italic/fontSize/fontName/color。"
    }
  ]
}
